<!doctype html>
<html lang="pl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matrix AI Terminal - C & WebAssembly</title>
    <style>
        body {
            background-color: #000000;
            color: #00ff00;
            font-family: monospace;
            margin: 0;
            padding: 10px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            box-sizing: border-box;
        }
        .emscripten_border {
            border: 2px solid #00ff00;
            background-color: #000;
            box-shadow: 0 0 20px rgba(0, 255, 0, 0.2);
            border-radius: 4px;
            width: 100%;
            max-width: 750px;
        }
        #canvas {
            width: 100%;
            height: auto;
            display: block;
            outline: none;
            background-color: #000000;
        }
        .input-container {
            width: 100%;
            max-width: 750px;
            margin-top: 10px;
            display: flex;
            gap: 5px;
        }
        #terminal-input {
            flex-grow: 1;
            background-color: #050505;
            border: 1px solid #00ff00;
            color: #00ff00;
            font-family: monospace;
            font-size: 16px;
            padding: 8px;
            border-radius: 4px;
            outline: none;
        }
        #send-btn {
            background-color: #002200;
            border: 1px solid #00ff00;
            color: #00ff00;
            font-family: monospace;
            font-weight: bold;
            padding: 8px 15px;
            border-radius: 4px;
            cursor: pointer;
        }
        #send-btn:active {
            background-color: #00ff00;
            color: #000;
        }
    </style>
</head>
<body>

    <div class="emscripten_border">
        <canvas id="canvas" oncontextmenu="event.preventDefault()" tabindex="0"></canvas>
    </div>

    <!-- Pasek wpisywania dla telefonów i komputerów -->
    <div class="input-container">
        <input type="text" id="terminal-input" placeholder="Wpisz komendę lub gaworzenie AI..." autocomplete="off">
        <button id="send-btn" onclick="wyslijKomende()">WYŚLIJ</button>
    </div>

    <script type='text/javascript'>
        var Module = {
            preRun: [],
            postRun: [],
            print: function(text) { console.log("[WASM OUT]: " + text); },
            printErr: function(text) { console.error("[WASM ERR]: " + text); },
            canvas: (function() {
                var canvas = document.getElementById('canvas');
                window.addEventListener('load', function() { canvas.focus(); });
                window.addEventListener('click', function() { canvas.focus(); });
                return canvas;
            })()
        };

        // Funkcja wysyłająca tekst z HTML do kodu w C
        function wyslijKomende() {
            var input = document.getElementById('terminal-input');
            var val = input.value.trim();
            if (val.length > 0 && typeof Module.ccall === 'function') {
                // Wywołujemy funkcję z C zdefiniowaną przez EMSCRIPTEN_KEEPALIVE
                Module.ccall('zewnetrzny_input_ai', null, ['string'], [val]);
                input.value = '';
            }
        }

        // Obsługa klawisza Enter w polu input
        document.getElementById('terminal-input').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                wyslijKomende();
            }
        });
    </script>

    {{{ SCRIPT }}}

</body>
</html>